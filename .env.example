# ============================================
# SFTP Transfer Configuration
# ============================================
# Copy this file to .env and update values
# ============================================

# === SFTP Connection Settings ===
winscp_path = C:\Program Files (x86)\WinSCP\WinSCPnet.dll
sftp_hostname = sftp.example.com
sftp_port = 22
sftp_username = your_username
SshHostKeyFingerprint = ssh-rsa 2048 xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx

# === Authentication ===
# Path to your SSH private key in PPK format
privkey_path = C:\Users\your_name\.ssh\private_key.ppk
# Optional: Path to encrypted passphrase file (created automatically on first run)
passphrase_path = C:\path\to\passphrase.txt

# === Transfer Paths ===
# For import (download): remote -> local
# Comma-separated for multiple paths
remote_import_path = /remote/import/path
local_import_path = C:\local\import\path

# For export (upload): local -> remote
# Comma-separated for multiple paths
local_export_path = C:\local\export\path1,C:\local\export\path2
remote_export_path = /remote/export/path

# === Logging Settings ===
log_enabled = true
log_path = logs
log_retention_days = 30
# Log levels: DEBUG, INFO, WARNING, ERROR
log_level = INFO

# === Retry Settings ===
# Automatic retry on transient failures
retry_enabled = true
retry_attempts = 3
retry_delay_seconds = 5
retry_exponential_backoff = true

# === File Filtering ===
# Wildcard patterns (comma-separated for multiple)
# Only files matching include AND not matching exclude will be transferred
include_pattern = *
exclude_pattern = *.tmp,*.log,thumbs.db,desktop.ini

# === Notifications ===
# Supported providers: webhook, msteams, slack, graph
notify_enabled = false
notify_provider = msteams
notify_on_success = false
notify_on_failure = true

# --- Webhook Settings (for webhook, msteams, slack providers) ---
# Microsoft Teams: Create incoming webhook in Teams channel
# Slack: Create incoming webhook app at api.slack.com
# Generic webhook: Your custom endpoint URL
notify_webhook_url = https://your-webhook-url.com/endpoint

# --- Microsoft Graph API Settings (for graph provider) ---
# Use this for sending email via Microsoft 365 with OAuth 2.0
# Requires Azure AD app registration with Mail.Send permission
#
# To set up:
# 1. Register an app in Azure AD (portal.azure.com)
# 2. Add API permission: Microsoft Graph > Application > Mail.Send
# 3. Grant admin consent
# 4. Create a client secret
# 5. Fill in the values below
notify_graph_tenant_id = your-tenant-id
notify_graph_client_id = your-client-id
# Option 1: Store secret directly (not recommended for production)
notify_graph_client_secret = your-client-secret
# Option 2: Store secret in a file (more secure)
notify_graph_client_secret_path = C:\path\to\client_secret.txt
# Sender must be a valid mailbox in your tenant
notify_graph_from = sftp-alerts@yourdomain.com
# Comma-separated list of recipients
notify_graph_to = admin@yourdomain.com,ops@yourdomain.com
notify_graph_subject_prefix = [SFTP Transfer]

# === Backup Settings (Export Mode) ===
# Create backup of files before deleting after upload
backup_enabled = true
backup_path = backups
backup_retention_days = 7

# === Connection Settings ===
connection_timeout_seconds = 30

# === Remote OS Settings ===
# Path separator is auto-detected from remote paths (/ for Unix, \ for Windows)
# Override if auto-detection doesn't work correctly:
# remote_path_separator = /
